.direnv
target
.gemini

# Your own securities: the names you hold and the splits they had.
# securities.example.toml ships in its place.
securities.toml

*.csv
sqlite.db

# The baked SQLite ledger — the app's source of truth, so real financial data.
# The bake writes it here by default; keep it out of git like every other input.
ledger-app.db

# Imported transaction history — same financial data the *.csv rule keeps out.
ledger/generated/

# AI-session scratch: plans, analyses and working notes. Not project docs, and
# not enumerated file by file — anything an assistant leaves here stays local.
.claude/

# Fava loads the extension as a Python module from ledger/.
ledger/__pycache__/

# Your own chart of accounts: account numbers, who you split bills with, and
# which records you have corrected. mapping.example.toml ships in its place.
ledger/mapping.toml

# Hand-entered cash — financial data, same as the CSVs.
# manual.example.csv ships in its place; copy it to get started. The blanket
# *.csv rule above would swallow the example too, so it is re-included here.
ledger/manual.csv
!ledger/manual.example.csv
